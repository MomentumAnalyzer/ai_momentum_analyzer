{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trading Wiser Zone Analysis Report Data",
  "type": "object",
  "required": [
    "symbol",
    "report_date",
    "summary_cards",
    "market_sentiment",
    "supports",
    "resistances",
    "technical_indicators",
    "risks",
    "working",
    "implications",
    "recommendations",
    "public_market_check"
  ],
  "properties": {
    "symbol": {"type": "string"},
    "report_date": {"type": "string"},
    "summary_cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "market_sentiment": {
      "type": "object",
      "properties": {
        "fed_label": {"type": ["string", "null"]},
        "fed_score": {"type": ["number", "string", "null"]},
        "symbol_summary": {"type": ["string", "null"]}
      }
    },
    "supports": {"type": "array", "items": {"$ref": "#/$defs/zone"}},
    "resistances": {"type": "array", "items": {"$ref": "#/$defs/zone"}},
    "technical_indicators": {"type": "array", "items": {"$ref": "#/$defs/reading"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "working": {"type": "array", "items": {"type": "string"}},
    "implications": {"type": "array", "items": {"$ref": "#/$defs/implication"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
    "public_market_check": {
      "type": "object",
      "required": ["overall", "rows"],
      "properties": {
        "overall": {"enum": ["match", "conflict", "thin"]},
        "checked_at": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "disclaimer": {"type": ["string", "null"]}
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": ["title", "value"],
      "properties": {
        "title": {"type": "string"},
        "value": {"type": ["string", "number", "null"]},
        "subtitle": {"type": ["string", "null"]}
      }
    },
    "zone": {
      "type": "object",
      "properties": {
        "name": {"type": ["string", "null"]},
        "timeframe": {"type": ["string", "null"]},
        "low": {"type": ["string", "number", "null"]},
        "mid": {"type": ["string", "number", "null"]},
        "high": {"type": ["string", "number", "null"]},
        "strength": {"enum": ["major", "moderate", "minor", "strong", "mild", null]},
        "touches": {"type": ["integer", "null"]},
        "rejections": {"type": ["integer", "null"]},
        "breakouts": {"type": ["integer", "null"]},
        "rejection_rate": {"type": ["string", "number", "null"]},
        "distance_atr": {"type": ["string", "number", "null"]},
        "distance_pct": {"type": ["string", "number", "null"]},
        "key_insight": {"type": ["string", "null"]}
      }
    },
    "reading": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": ["string", "number", "null"]},
        "reading": {"type": ["string", "null"]}
      }
    },
    "implication": {
      "type": "object",
      "required": ["zone", "price_range", "action", "conviction"],
      "properties": {
        "zone": {"type": "string"},
        "price_range": {"type": "string"},
        "action": {"enum": ["hold", "wait", "stop"]},
        "conviction": {"type": "string"}
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["audience", "text"],
      "properties": {
        "audience": {"type": "string"},
        "text": {"type": "string"}
      }
    },
    "check": {
      "type": "object",
      "required": ["field", "momentum_analyzer", "public", "source", "result"],
      "properties": {
        "field": {"type": "string"},
        "momentum_analyzer": {"type": ["string", "number", "null"]},
        "public": {"type": ["string", "number", "null"]},
        "source": {"type": ["string", "null"]},
        "result": {"enum": ["match", "conflict", "thin"]},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
